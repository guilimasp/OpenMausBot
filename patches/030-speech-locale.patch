diff --git a/electron/resources/speech-helper.swift b/electron/resources/speech-helper.swift
index edfda88..8a37992 100644
--- a/electron/resources/speech-helper.swift
+++ b/electron/resources/speech-helper.swift
@@ -132,7 +132,22 @@ SFSpeechRecognizer.requestAuthorization { status in
   // Recognize in the user's language: a hardcoded en-US recognizer
   // transcribes everyone else into nonsense. First preference that has an
   // available recognizer wins, with en-US as the last resort.
-  let candidates =
+  //
+  // The system language is not a reliable proxy for the language someone
+  // speaks — a Mac kept in English by someone who dictates in Portuguese is
+  // the ordinary case — so an explicit setting wins over the preferences.
+  // Set it with {"dictation":{"locale":"pt-BR"}} in ~/.openmausbot/config.json.
+  var candidates: [Locale] = []
+  let configURL = FileManager.default.homeDirectoryForCurrentUser
+    .appendingPathComponent(".openmausbot/config.json")
+  if let data = try? Data(contentsOf: configURL),
+    let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+    let dictation = root["dictation"] as? [String: Any],
+    let identifier = dictation["locale"] as? String
+  {
+    candidates.append(Locale(identifier: identifier))
+  }
+  candidates +=
     Locale.preferredLanguages.map { Locale(identifier: $0) }
     + [Locale.current, Locale(identifier: "en-US")]
   guard
